{
  "comment": "Configuration template for personal operating system. Copy to env.json and fill in your values.",
  "system": {
    "version": "1.0",
    "environment": "development",
    "log_level": "INFO",
    "log_to_file": false,
    "log_suppress_stdout_if_jsonl": false,
    "data_directory": "./data",
    "output_directory": "./output"
  },
  "excel": {
    "system_of_record_path": "./excel-templates/system-of-record-template.xlsx",
    "dashboard_path": "./excel-templates/dashboards/60d_operating_dashboard.xlsx",
    "backup_directory": "./backups/excel",
    "auto_backup": true
  },
  "job_discovery": {
    "enabled": true,
    "sources": {
      "linkedin": {
        "enabled": false,
        "comment": "LinkedIn API access requires premium account",
        "api_key": "YOUR_LINKEDIN_API_KEY_HERE",
        "api_url": "https://api.linkedin.com/v2/jobs"
      },
      "indeed": {
        "enabled": true,
        "publisher_key": "YOUR_INDEED_PUBLISHER_KEY_HERE",
        "api_url": "https://api.indeed.com/v2/jobs"
      },
      "custom_sources": [
        {
          "name": "ServiceNow Careers (SF/Santa Clara filters)",
          "url": "https://careers.servicenow.com/jobs/?team=Product&team=Professional%20Services&team=Engineering,%20Infrastructure%20and%20Operations&team=Digital%20Technology&team=Customer%20Outcomes&location=San%20Francisco&location=Santa%20Clara&pagesize=20#results",
          "enabled": true
        },
        {
          "name": "ServiceNow Community Jobs",
          "url": "https://www.servicenow.com/community/servicenow-jobs/ct-p/servicenow-jobs",
          "enabled": true
        },
        {
          "name": "SNPro Jobs",
          "url": "https://snpro.jobs/jobs",
          "enabled": true
        },
        {
          "name": "ServiceNow WillHire Jobs",
          "url": "https://servicenow.willhire.co/jobs/?&industry=CLOUD405,DEX932,ENGIN282,INFOR608,PMO858,PROFE207,SUPPO380,ALL&sort=recent&keyword=&location=&locationId=&country=US&assignmentType=undefined&jobType=remote",
          "enabled": true
        },
        {
          "name": "Robert Half ServiceNow Jobs",
          "url": "https://www.roberthalf.com/us/en/jobs/all/servicenow?postedwithin=7",
          "enabled": true
        },
        {
          "name": "Nelson Frank ServiceNow Jobs",
          "url": "https://www.nelsonfrank.com/servicenow-jobs?keyword=servicenow&location=&segment=&product=&jobType=both",
          "enabled": true
        }
      ]
    },
